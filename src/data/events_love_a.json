          "good": { "narrative": "成了五枚。她捧着那五枚看了很久，然后小心地包起来，说要送一枚回家去。", "effects": [ { "type": "relation", "favor": 18, "trust": 20, "bond": 20 }, { "type": "flag", "key": "wen_pill_done" }, { "type": "item", "id": "huichun_dan", "value": 2 }, { "type": "reputation", "value": 4 } ] },
          "plain": { "narrative": "成了两枚，成色一般。她说下次再来。", "effects": [ { "type": "relation", "favor": 10, "bond": 12 }, { "type": "item", "id": "huichun_dan", "value": 1 } ] },
          "bad": { "narrative": "炉子熄了。她盯着冷掉的炉膛看了很久，然后说：「没事。第二十三次了。」\n\n你这才知道她试了多少回。", "effects": [ { "type": "relation", "favor": 8, "trust": 12, "bond": 10 }, { "type": "demon", "value": 4, "source": "love" } ] },
          "terrible": { "narrative": "炉子炸了。\n\n她扑过来把你按在身下，自己的后背被溅到了。\n\n躺在丹霞院的床上她还在笑：「你看，我这手艺，护人比炼丹强。」", "effects": [ { "type": "relation", "favor": 15, "bond": 25, "trust": 15, "note": "炉子炸的时候她把你按在了身下" }, { "type": "injury", "key": "burn", "value": 1, "weeks": 2 }, { "type": "demon", "value": 8, "source": "guilt" } ] }
        } },
      { "id": "B", "text": "上手帮她控火", "reason": 8, "check": { "attr": "wu", "difficulty": 58 },
        "outcomes": {
          "perfect": { "narrative": "你接过了控火。她腾出手来专心投药，两个人配合得像练过千百遍。\n\n炉开的时候她第一句话是：「你怎么知道那个时候该收火。」\n\n你说看你炼了三年，总看会了一点。\n\n她愣了很久，然后很小声地说了句：「三年啊。」", "effects": [ { "type": "relation", "favor": 22, "trust": 22, "bond": 28, "note": "你替她控了三年学会的那把火" }, { "type": "flag", "key": "wen_pill_done" }, { "type": "item", "id": "huichun_dan", "value": 3 }, { "type": "attr", "key": "wu", "value": 1 }, { "type": "reputation", "value": 6 } ] },
          "good": { "narrative": "火控得不错，丹成了四枚。她说以后炼丹都叫你。", "effects": [ { "type": "relation", "favor": 16, "bond": 18 }, { "type": "flag", "key": "wen_pill_done" }, { "type": "item", "id": "huichun_dan", "value": 2 } ] },
          "plain": { "narrative": "勉强控住了。成了一枚，还是次品。", "effects": [ { "type": "relation", "favor": 8, "bond": 8 } ] },
          "bad": { "narrative": "你的火候差了一线，一炉药废了大半。她说没事，但你看见她把废渣收起来的时候手很慢。", "effects": [ { "type": "relation", "favor": 2 }, { "type": "demon", "value": 5, "source": "guilt" } ] },
          "terrible": { "narrative": "你把火催过了。整炉药在一瞬间烧成了灰。\n\n那里面有她父亲留下的最后一点药引。\n\n她蹲在地上收拾了很久很久，一句话没说。", "effects": [ { "type": "relation", "favor": -15, "trust": -12, "note": "你烧掉了她父亲留下的最后一点药引" }, { "type": "demon", "value": 14, "source": "guilt", "note": "那炉烧成灰的药" } ] }
        } },
      { "id": "C", "text": "去把苏暮寒请来", "reason": 14, "check": { "attr": "shi", "difficulty": 50 },
        "outcomes": {
          "perfect": { "narrative": "苏暮寒来了，站在门口没有进去。\n\n她看了一炷香，忽然开口：「第三次投药，慢半息。」\n\n温酒酒照做了。炉开时苏暮寒走过去，拿起一枚看了很久，说了句这辈子最长的评价：「这个方子，我一百二十年前没敢往下写。」\n\n她把丹放回去：「你比我强。」", "effects": [ { "type": "relation", "npc": "npc_wenjiujiu", "favor": 20, "trust": 22, "bond": 22 }, { "type": "relation", "npc": "npc_sumuhan", "favor": 15, "trust": 15, "note": "她说温酒酒比她强" }, { "type": "flag", "key": "wen_pill_done" }, { "type": "item", "id": "huichun_dan", "value": 3 }, { "type": "storyline", "key": "rootSecret", "value": 15, "clue": "苏暮寒的丹方" }, { "type": "reputation", "value": 8 } ] },
          "good": { "narrative": "苏暮寒指点了两处，丹成了三枚。她走的时候留下一句：「以后可以来问我。」", "effects": [ { "type": "relation", "npc": "npc_wenjiujiu", "favor": 14, "bond": 16 }, { "type": "relation", "npc": "npc_sumuhan", "favor": 10 }, { "type": "flag", "key": "wen_pill_done" }, { "type": "item", "id": "huichun_dan", "value": 2 }, { "type": "storyline", "key": "rootSecret", "value": 8 } ] },
          "plain": { "narrative": "苏暮寒不在丹房。等你找到她时，炉子已经开了——成了一枚。", "effects": [ { "type": "relation", "npc": "npc_wenjiujiu", "favor": 8 }, { "type": "item", "id": "huichun_dan", "value": 1 } ] },
          "bad": { "narrative": "你离开的那半个时辰，她一个人守着炉子。\n\n炉子成了，但她说的第一句是：「我以为你不走的。」", "effects": [ { "type": "relation", "npc": "npc_wenjiujiu", "favor": -6, "trust": -8 }, { "type": "flag", "key": "wen_pill_done" }, { "type": "demon", "value": 6, "source": "guilt", "note": "那句'我以为你不走的'" } ] },
          "terrible": { "narrative": "苏暮寒看了一眼方子，脸色变了：「这个引子不能用。」\n\n话音未落，炉子就炸了。\n\n后来苏暮寒说，那个引子她一百二十年前用过一次。她没有说后面的事。", "effects": [ { "type": "relation", "npc": "npc_wenjiujiu", "favor": 5, "bond": 15 }, { "type": "injury", "key": "burn", "value": 2, "weeks": 3 }, { "type": "storyline", "key": "rootSecret", "value": 18, "clue": "禁丹残渣" }, { "type": "demon", "value": 10, "source": "guilt" } ] }
