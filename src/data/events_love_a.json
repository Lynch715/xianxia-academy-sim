    "important": true,
    "conditions": {
      "role": ["student"], "minWeek": 46,
      "relations": { "npc_shenjinglan": { "favor": [55, 100], "trust": [40, 100] } },
      "notFlags": ["love_shen_1", "in_relationship"]
    },
    "seed": "练剑场的灯还亮着，但没有剑声。\n\n沈惊澜坐在台阶上，手里捏着一封信，捏得纸边都毛了。看见你，他把信折起来塞进袖子——那个动作太快，快得像被抓到了什么。\n\n「北境来的。」他自己说了出来，好像不说会更难受，「家里给了期限。五年结丹，否则换嫡。」\n\n他停了停：「还剩两年。」",
    "facts": ["沈惊澜收到北境家书", "家族给了五年结丹的期限，只剩两年", "他第一次主动说出这件事"],
    "options": [
      { "id": "A", "text": "问他，如果没做到会怎样", "reason": 12, "check": { "attr": "shi", "difficulty": 48 },
        "outcomes": {
          "perfect": { "narrative": "他没有立刻回答。风把他额前的碎发吹起来又落下。\n\n「换个人当嫡子。」他说，「我还是我，只是不姓那个沈了。」他忽然笑了一下——你从没见他笑过，「其实这样也行。我小时候想过，要是能不当这个嫡子……」\n\n他没说完。但你听懂了后半句。\n\n那句没说完的话，比他说出来的所有话都重。", "effects": [ { "type": "relation", "favor": 15, "trust": 22, "bond": 14, "note": "他说漏了小时候想过的事", "openRomance": true }, { "type": "flag", "key": "love_shen_1" }, { "type": "flag", "key": "shen_deadline_known" } ] },
          "good": { "narrative": "「换个人。」他说得很平，「就这样。」\n\n但他捏着袖口的手一直没松。", "effects": [ { "type": "relation", "favor": 10, "trust": 14, "bond": 8, "openRomance": true }, { "type": "flag", "key": "love_shen_1" }, { "type": "flag", "key": "shen_deadline_known" } ] },
          "plain": { "narrative": "他摇了摇头，站起来去拿剑。这个话题就这么断了。", "effects": [ { "type": "relation", "favor": 4, "trust": 5 }, { "type": "flag", "key": "love_shen_1" } ] },
          "bad": { "narrative": "他的背绷紧了：「问这个做什么。」\n\n剑重新出鞘的声音很利。", "effects": [ { "type": "relation", "favor": -3, "trust": 3 }, { "type": "flag", "key": "love_shen_1" } ] },
          "terrible": { "narrative": "你说了句「那也没什么大不了」。\n\n他抬起头看你，眼睛里有一种你没见过的东西。「没什么大不了。」他重复了一遍，然后拿起剑走了。\n\n那晚练功场的灯亮到天明。", "effects": [ { "type": "relation", "favor": -10, "trust": -8, "note": "你说了句'那也没什么大不了'" }, { "type": "flag", "key": "love_shen_1" }, { "type": "demon", "value": 5, "source": "guilt" } ] }
        } },
      { "id": "B", "text": "坐下来，陪他把这封信读完", "reason": 16, "check": { "attr": "xin", "difficulty": 35 },
        "outcomes": {
          "perfect": { "narrative": "你在他旁边坐下，没有伸手要那封信，也没有问。\n\n过了很久，他自己把信摊开了，一句一句念给你听。北境的家书写得又硬又冷，每一句都是「望汝」「切记」「勿负」。\n\n念到最后一句，他停了一下。那句是：「汝母甚念。」\n\n「就这四个字，」他说，「是我娘偷偷加的。」", "effects": [ { "type": "relation", "favor": 18, "trust": 25, "bond": 18, "note": "他把家书念给你听，包括他娘偷偷加的那四个字", "openRomance": true }, { "type": "flag", "key": "love_shen_1" }, { "type": "flag", "key": "shen_deadline_known" }, { "type": "attr", "key": "xin", "value": 1 } ] },
          "good": { "narrative": "你坐下了。他把信念了一半，然后收了起来。\n\n「够了。」他说。但他没有走。", "effects": [ { "type": "relation", "favor": 12, "trust": 16, "bond": 12, "openRomance": true }, { "type": "flag", "key": "love_shen_1" }, { "type": "flag", "key": "shen_deadline_known" } ] },
          "plain": { "narrative": "两个人在台阶上坐到很晚。信始终没有打开。", "effects": [ { "type": "relation", "favor": 6, "trust": 8, "bond": 5 }, { "type": "flag", "key": "love_shen_1" } ] },
          "bad": { "narrative": "他站了起来：「回去睡吧。」", "effects": [ { "type": "relation", "favor": 2, "trust": 3 }, { "type": "flag", "key": "love_shen_1" } ] },
          "terrible": { "narrative": "你伸手去拿那封信。\n\n他躲开了。动作不大，但很快，是练剑的人才有的那种快。\n\n两个人都愣了一下。然后他说：「抱歉。」抱歉完就走了。", "effects": [ { "type": "relation", "favor": -8, "trust": -10 }, { "type": "flag", "key": "love_shen_1" } ] }
        } },
      { "id": "C", "text": "说你会陪他练，练到结丹为止", "reason": 10, "check": { "attr": "gen", "difficulty": 45 },
        "outcomes": {
          "perfect": { "narrative": "你说完，他愣了很久。\n\n「两年。」他说，「你知道两年有多少个晚上吗。」\n\n你说知道。你确实算过。\n\n他把剑扔给你——不是木剑，是他那柄真的。「那就从今晚开始。」", "effects": [ { "type": "relation", "favor": 16, "trust": 18, "bond": 20, "note": "你答应陪他练到结丹", "openRomance": true }, { "type": "flag", "key": "love_shen_1" }, { "type": "flag", "key": "shen_deadline_known" }, { "type": "flag", "key": "shen_pact" }, { "type": "exp", "value": 60 } ] },
          "good": { "narrative": "他没有推辞。从那晚起，练功场上多了一个人。", "effects": [ { "type": "relation", "favor": 12, "bond": 14, "openRomance": true }, { "type": "flag", "key": "love_shen_1" }, { "type": "flag", "key": "shen_pact" }, { "type": "exp", "value": 40 } ] },
          "plain": { "narrative": "他说了句「随你」。你不确定这算不算答应。", "effects": [ { "type": "relation", "favor": 5, "bond": 5 }, { "type": "flag", "key": "love_shen_1" } ] },
          "bad": { "narrative": "「你跟不上。」他说的是实话，但实话最难听。", "effects": [ { "type": "relation", "favor": -2, "awe": -3 }, { "type": "flag", "key": "love_shen_1" }, { "type": "demon", "value": 3, "source": "inferior" } ] },
          "terrible": { "narrative": "「这是我家的事。」他把剑收了，「跟你没关系。」\n\n他走出去很远才停下，背对着你站了一会儿，然后接着走了。", "effects": [ { "type": "relation", "favor": -12, "trust": -6 }, { "type": "flag", "key": "love_shen_1" }, { "type": "demon", "value": 5, "source": "love" } ] }
        } }
    ],
    "chainNext": { "on": ["perfect", "good"], "eventId": "evt_love_shen_2", "delayWeeks": 6 }
  },

  {
    "id": "evt_love_shen_2",
    "category": "romance",
    "chainOnly": true,
    "chainId": "love_shen",
